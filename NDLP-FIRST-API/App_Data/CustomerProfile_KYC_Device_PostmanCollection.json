						"url": {
							"raw": "{{base_url}}/api/v1/customers?searchTerm=John&status=ACTIVE&pageNumber=1&pageSize=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"customers"
