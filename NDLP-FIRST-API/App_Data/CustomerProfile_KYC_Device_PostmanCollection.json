						"url": {
							"raw": "{{base_url}}/api/v1/customers/{{customer_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"customers",
								"{{customer_id}}"
							]
						}
					},
					"response": []
